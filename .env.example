# Copy to .env next to docker-compose.yml, then fill in your own credentials.
#
#   cp .env.example .env
#
# Game metadata comes from IGDB, which authenticates through Twitch. Register
# an application at https://dev.twitch.tv/console/apps to get a client ID and
# secret. The app exchanges them for a token automatically and refreshes it.

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
